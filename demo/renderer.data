# « 1992 » : une démo dans le style des démos PC des années 90 (60 s), lancée avec
#   CPU_Engine.exe
#
# Notre résolution, 320 x 180, est presque celle du mode 13h (320 x 200) de ces démos.
# 8 scènes de 4 mesures (7,5 s à 128 BPM), coupées net sur le temps, comme à l'époque. Chacune a un effet
# classique en fond (plasma, copper bars, feu, étoiles, rotozoom, tunnel), des objets 3D du moteur par-dessus,
# et le texte qui défile en vague. Tout suit la musique (kick, basses, aigus, temps).

[demo]
music = generated:drive
bpm = 128
scene = Assets/scenes/1992_1_etoiles.scene
scene = Assets/scenes/1992_2_copper.scene
scene = Assets/scenes/1992_3_plasma.scene
scene = Assets/scenes/1992_4_feu.scene
scene = Assets/scenes/1992_5_rotozoom.scene
scene = Assets/scenes/1992_6_tunnel.scene
scene = Assets/scenes/1992_7_danse.scene
scene = Assets/scenes/1992_8_fin.scene
# 1992, 1 : le champ d'étoiles. On file à travers les étoiles, qui accélèrent sur chaque kick ;
# le texte d'accueil défile en vague.

[scene]
name = 1992 - les etoiles
duration = 7.5

[mesh cube]
type = cube
size = 1
color = 1 1 1

[mesh sphere]
type = obj
file = Assets/SpherewithShadeSmooth.obj
color = 1 1 1

[camera]
animation = fixed
position = 0 0 4

[render]
dither = 6
oldschool = stars
oldschool_audio = kick 2

scroller = BIENVENUE EN 1992 ... UN MOTEUR 3D 100% CPU !
scroller_speed = 105
scroller_y = 0.5
scroller_wave = 18
scroller_size = 3
scroller_audio = kick 0.6
# 1992, 2 : copper bars. Huit barres de couleur rebondissent derrière un cube 3D (rasterisé par le moteur,
# éclairé par Lambert) qui tourne plus vite sur les basses et grossit sur chaque kick.

[scene]
name = 1992 - copper bars
duration = 7.5

[mesh cube]
type = cube
size = 1
color = 1 1 1

[mesh sphere]
type = obj
file = Assets/SpherewithShadeSmooth.obj
color = 1 1 1

[light cle]
direction = -0.4 -0.8 -0.6
color = 1 1 1
intensity = 0.9
intensity_audio = kick 0.5

[light gauche]
direction = 1 -0.2 -0.3
color = 0.6 0.5 1
intensity = 0.45

[light droite]
direction = -1 -0.2 -0.3
color = 1 0.5 0.6
intensity = 0.45

[entity cube]
mesh = cube
shader = lambert
scale = 1.3
spin = 0.9 1.3 0.4
spin_audio = bass 2
scale_audio = kick 0.25

[camera]
animation = fixed
position = 0 0 4.5

[render]
dither = 6
oldschool = copper
oldschool_audio = kick 1
oldschool_hue_speed = 0.15

scroller = DES BARRES, UN CUBE ... ET 0 CARTE GRAPHIQUE
scroller_speed = 100
scroller_y = 0.88
scroller_wave = 6
scroller_size = 2
# 1992, 3 : le plasma. Quatre ondes additionnées, une palette de 256 couleurs qui tourne (palette cycling)
# et qui saute sur chaque temps ; un anneau de cubes passe devant.

[scene]
name = 1992 - plasma
duration = 7.5

[mesh cube]
type = cube
size = 1
color = 1 1 1

[mesh sphere]
type = obj
file = Assets/SpherewithShadeSmooth.obj
color = 1 1 1

[light cle]
direction = -0.4 -0.8 -0.6
color = 1 1 1
intensity = 0.9
intensity_audio = kick 0.5

[light gauche]
direction = 1 -0.2 -0.3
color = 0.6 0.5 1
intensity = 0.45

[light droite]
direction = -1 -0.2 -0.3
color = 1 0.5 0.6
intensity = 0.45

[material blanc]
color = 1 1 1
pulse_audio = kick 0.4

[ring cubes]
mesh = cube
material = blanc
shader = lambert
count = 10
radius = 2.2
speed = 0.9
scale = 0.35
spin = 1 2 0
radius_audio = kick 0.25

[camera]
animation = fixed
position = 0 2.2 5
target = 0 0 0

[render]
dither = 6
oldschool = plasma
oldschool_speed = 1
oldschool_audio = bass 0.5
oldschool_hue_speed = 0.2
oldschool_hue_audio = beat 0.6

scroller = PLASMA = 4 SINUS + 1 PALETTE QUI TOURNE
scroller_speed = 100
scroller_y = 0.12
scroller_wave = 6
scroller_size = 2
# 1992, 4 : le feu. Les flammes montent du bas de l'écran (chaque pixel = moyenne des pixels du dessous,
# refroidie) et s'embrasent sur les basses ; une sphère flotte au-dessus en rebondissant sur chaque temps.

[scene]
name = 1992 - le feu
duration = 7.5

[mesh cube]
type = cube
size = 1
color = 1 1 1

[mesh sphere]
type = obj
file = Assets/SpherewithShadeSmooth.obj
color = 1 1 1

[light cle]
direction = -0.4 -0.8 -0.6
color = 1 1 1
intensity = 0.9
intensity_audio = kick 0.5

[light gauche]
direction = 1 -0.2 -0.3
color = 0.6 0.5 1
intensity = 0.45

[light droite]
direction = -1 -0.2 -0.3
color = 1 0.5 0.6
intensity = 0.45

[material orbe]
color = 1.0 0.85 0.5
pulse_audio = kick 0.5

[entity orbe]
mesh = sphere
material = orbe
shader = lambert
position = 0 -0.7 0
scale = 0.7
bob = 0.25 13.4
spin = 0 1 0

[camera]
animation = fixed
position = 0 0 4.5

[render]
dither = 6
oldschool = fire
oldschool_audio = bass 0.8

scroller = CA CHAUFFE !!! ... LE FEU, PIXEL PAR PIXEL
scroller_speed = 100
scroller_y = 0.14
scroller_wave = 8
scroller_size = 2
# 1992, 5 : le rotozoom. Un motif XOR qui tourne et zoome ; devant, des « vector balls » : deux anneaux de
# sphères qui tournent en sens contraires et s'écartent sur chaque kick.

[scene]
name = 1992 - rotozoom
duration = 7.5

[mesh cube]
type = cube
size = 1
color = 1 1 1

[mesh sphere]
type = obj
file = Assets/SpherewithShadeSmooth.obj
color = 1 1 1

[light cle]
direction = -0.4 -0.8 -0.6
color = 1 1 1
intensity = 0.9
intensity_audio = kick 0.5

[light gauche]
direction = 1 -0.2 -0.3
color = 0.6 0.5 1
intensity = 0.45

[light droite]
direction = -1 -0.2 -0.3
color = 1 0.5 0.6
intensity = 0.45

[material rouge]
color = 1 0.3 0.3

[material cyan]
color = 0.3 0.9 1

[ring balles]
mesh = sphere
material = rouge
shader = lambert
count = 12
radius = 2
position = 0 -0.25 0
speed = 1.2
scale = 0.25
radius_audio = kick 0.35
bob = 0.3 6.7
phase_step = 1.0472

[ring balles_interieur]
mesh = sphere
material = cyan
shader = lambert
count = 6
radius = 1
position = 0 -0.2 0
speed = -1.8
scale = 0.2
radius_audio = kick 0.5

[camera]
animation = fixed
position = 0 2.5 5
target = 0 0 0

[render]
dither = 6
oldschool = rotozoom
oldschool_audio = kick 0.6
oldschool_hue_speed = 0.25

scroller = VECTOR BALLS + ROTOZOOM ... LES CLASSIQUES !
scroller_speed = 100
scroller_y = 0.88
scroller_wave = 6
scroller_size = 2
# 1992, 6 : le tunnel. Angle et profondeur précalculés pour chaque pixel ; on avance et le tunnel tourne,
# plus vite sur chaque kick. Un cube tourne au centre.

[scene]
name = 1992 - tunnel
duration = 7.5

[mesh cube]
type = cube
size = 1
color = 1 1 1

[mesh sphere]
type = obj
file = Assets/SpherewithShadeSmooth.obj
color = 1 1 1

[light cle]
direction = -0.4 -0.8 -0.6
color = 1 1 1
intensity = 0.9
intensity_audio = kick 0.5

[light gauche]
direction = 1 -0.2 -0.3
color = 0.6 0.5 1
intensity = 0.45

[light droite]
direction = -1 -0.2 -0.3
color = 1 0.5 0.6
intensity = 0.45

[entity cube]
mesh = cube
shader = lambert
scale = 0.6
spin = 1.5 2 0.7
spin_audio = kick 3
scale_audio = kick 0.3

[camera]
animation = fixed
position = 0 0 4

[render]
dither = 6
oldschool = tunnel
oldschool_speed = 1
oldschool_audio = kick 1.5
oldschool_hue_speed = 0.15

scroller = ON ACCELERE ... TOUJOURS PLUS VITE !
scroller_speed = 110
scroller_y = 0.88
scroller_wave = 10
scroller_size = 2
# 1992, 7 : la danse. Seize cubes sautent sur chaque kick et tournent sur les basses, devant un plasma
# qui change de couleur à chaque temps.

[scene]
name = 1992 - la danse
duration = 7.5

[mesh cube]
type = cube
size = 1
color = 1 1 1

[mesh sphere]
type = obj
file = Assets/SpherewithShadeSmooth.obj
color = 1 1 1

[light cle]
direction = -0.4 -0.8 -0.6
color = 1 1 1
intensity = 0.9
intensity_audio = kick 0.5

[light gauche]
direction = 1 -0.2 -0.3
color = 0.6 0.5 1
intensity = 0.45

[light droite]
direction = -1 -0.2 -0.3
color = 1 0.5 0.6
intensity = 0.45

# Une couleur de base vive : la teinte tourne (hue_speed), ce qui serait sans effet sur du blanc.
[material danseur]
color = 1 0.35 0.6
hue_speed = 0.8
pulse_audio = kick 0.4

[grid danseurs]
mesh = cube
material = danseur
shader = lambert
count = 4 4
spacing = 1.1
position = 0 -0.8 0
scale = 0.45
lift_audio = kick 0.6
bob = 0.1 6.7
phase_step = 0.8
spin = 0 1.5 0
spin_step = 0 0.2 0
spin_audio = bass 2

[camera]
animation = orbit
radius = 6
height = 2.5
speed = 0.4
target = 0 -0.3 0

[render]
dither = 6
oldschool = plasma
oldschool_speed = 1.5
oldschool_audio = kick 0.4
oldschool_hue_speed = 0.1
oldschool_hue_audio = beat 1

scroller = TOUT LE MONDE DANSE !!!
scroller_speed = 100
scroller_y = 0.12
scroller_wave = 10
scroller_size = 3
# 1992, 8 : la fin. Retour dans les étoiles, un grand cube qui tourne, et le message de fin.

[scene]
name = 1992 - la fin
duration = 7.5

[mesh cube]
type = cube
size = 1
color = 1 1 1

[mesh sphere]
type = obj
file = Assets/SpherewithShadeSmooth.obj
color = 1 1 1

[light cle]
direction = -0.4 -0.8 -0.6
color = 1 1 1
intensity = 0.9
intensity_audio = kick 0.5

[light gauche]
direction = 1 -0.2 -0.3
color = 0.6 0.5 1
intensity = 0.45

[light droite]
direction = -1 -0.2 -0.3
color = 1 0.5 0.6
intensity = 0.45

[entity cube]
mesh = cube
shader = lambert
scale = 1.1
spin = 0.6 0.9 0.3
scale_audio = kick 0.2

[camera]
animation = fixed
position = 0 0 4.5

[render]
dither = 6
oldschool = stars
oldschool_audio = kick 1.5

scroller = MERCI D'AVOIR REGARDE ... CPU ENGINE - 2026
scroller_speed = 105
scroller_y = 0.88
scroller_wave = 12
scroller_size = 2
# La théière de l'Utah, seule : la scène affichée en haut du portfolio.

[scene]
name = theiere
duration = 62.832

[mesh teapot]
type = obj
file = Assets/teapot.obj
color = 1 1 1

[light cle]
direction = -0.4 -0.8 -0.6
color = 1 1 1
intensity = 0.9

[light gauche]
direction = 1 -0.2 -0.3
color = 0.6 0.5 1
intensity = 0.45

[light droite]
direction = -1 -0.2 -0.3
color = 1 0.5 0.6
intensity = 0.45

[material porcelain]
color = 0.95 0.93 0.88

[entity teapot]
mesh = teapot
material = porcelain
shader = lambert
position = 0 0 0
scale = 1
spin = 0 1 0

[camera]
animation = fixed
position = 0 0.8 3
target = 0 0 0

[render]
dither = 6
# La théière de l'Utah, seule : la scène affichée en haut du portfolio.
[demo]
music = none
scene = Assets/scenes/theiere.scene
